VITE_SBHS_CLIENT_ID=your_client_id_here
VITE_SBHS_REDIRECT_URI=http://localhost:5173/callback
# Only when the API is on a different origin from the app (default: /api)
# VITE_ADMIN_API_URL=https://synchron.work/api

# Never put the client secret in a VITE_ variable: those are built into the
# public JavaScript. Set SBHS_CLIENT_SECRET on the server instead.
