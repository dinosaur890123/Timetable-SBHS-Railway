# Postgres (set ONE of these)
POSTGRES_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# SBHS sign-in. The server exchanges sign-in codes with SBHS so the client
# secret never reaches the browser. If unset, the VITE_SBHS_* values are used.
SBHS_CLIENT_ID=your_client_id_here
SBHS_CLIENT_SECRET=your_client_secret_here
SBHS_REDIRECT_URI=http://localhost:5173/callback

# Optional
# Extra origins allowed to call the API from a browser (the app's own origin always is)
# ALLOWED_ORIGINS=https://example.com
# Local development only; ignored in production
# BYPASS_AUTH=true
PGPOOL_MAX=5
# PGSSLMODE=disable
# TRANSPORT_NSW_API_KEY=your-nsw-transport-open-data-key-here

